# Не загружать на EAS эти папки/файлы

# Android build папки (Android собираем локально в Android Studio,
# на EAS эти артефакты не нужны ни для одной платформы)
android/app/build/
android/app/.cxx/
android/app/release/
android/.gradle/
android/.cxx/
android/build/

# Исходники книги: 24 МБ сканов, в сборку не входят
content/

# Node modules кэш (будет переустановлен на сервере)
node_modules/

# iOS (не нужен для Android билда)
ios/

# Git
.git/
.github/

# IDE
.vscode/
.idea/

# Документация
docs/
*.md
!README.md

# Тесты
__tests__/
*.test.ts
*.test.tsx

# Скрипты (не нужны для билда)
scripts/

# Кэш
.expo/
.expo-shared/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Временные файлы
*.tmp
*.temp
.DS_Store